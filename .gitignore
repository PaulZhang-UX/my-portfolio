# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local development artifacts
/dev-server-*.log
/dev-server-local.log
/.tmp-*
/tmp-*.png
/optimized-*.bin
/.project3-*

# build outputs & local junk (not for git)
/.next-broken-*/
/out-stale-*/
/release-pages*/
/.qa_clean_profile*/
/backups/
/tmp/
/experiments/
/.workbuddy/
/public/videos/ui-trace/workflow.mp4
